rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is accessing their own document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // User root document
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      // Profiles subcollection
      match /profiles/{profileId} {
        allow read, write: if isOwner(userId);
        
        // Profile specific My List
        match /my_list/{itemId} {
          allow read, write: if isOwner(userId);
        }
        
        // Profile specific Continue Watching
        match /continue_watching/{itemId} {
          allow read, write: if isOwner(userId);
        }
        
        // Profile specific Watch History
        match /history/{itemId} {
          allow read, write: if isOwner(userId);
        }
        
        // Profile specific Reactions (Likes/Dislikes)
        match /reactions/{itemId} {
          allow read, write: if isOwner(userId);
        }
        
        // Profile specific Notifications
        match /notifications/{notifId} {
          allow read, write: if isOwner(userId);
        }
      }
    }
    
    // Global public announcements
    match /system_announcements/{docId} {
      allow read: if true;
      allow write: if false; // Only admin via Admin SDK
    }
  }
}
